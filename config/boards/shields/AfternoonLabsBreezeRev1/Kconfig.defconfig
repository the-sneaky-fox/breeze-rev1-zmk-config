
if SHIELD_BREEZE_REV1_DONGLE

config ZMK_KEYBOARD_NAME
	default "Forest Breeze"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
	default 2

config BT_MAX_CONN
	default 7

config BT_MAX_PAIRED
	default 7

config ZMK_HID_INDICATORS
	default y

config INPUT_THREAD_PRIORITY_OVERRIDE
	default y if PROSPECTOR_TOUCHSCREEN

config INPUT_THREAD_PRIORITY
	default 4 if PROSPECTOR_TOUCHSCREEN

endif

if SHIELD_BREEZE_REV1_LEFT

config ZMK_KEYBOARD_NAME
	default "Forest Breeze"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

endif

if SHIELD_BREEZE_REV1_LEFT || SHIELD_BREEZE_REV1_RIGHT

config ZMK_SLEEP
	default y

endif

if SHIELD_BREEZE_REV1_DONGLE || SHIELD_BREEZE_REV1_LEFT || SHIELD_BREEZE_REV1_RIGHT

config ZMK_SPLIT
	default y

endif
